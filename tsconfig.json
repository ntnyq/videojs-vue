{
  "extends": "@ntnyq/tsconfig/strict.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "target": "ESNext",
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "videojs-vue/audio": ["./src/audio/index.ts"],
      "videojs-vue": ["./src/index.ts"],
      "videojs-vue/i18n": ["./src/i18n/index.ts"],
      "videojs-vue/media/hls": ["./src/media/hls.ts"],
      "videojs-vue/ui": ["./src/ui/index.ts"],
      "videojs-vue/core": ["./src/core/index.ts"],
      "videojs-vue/composables": ["./src/composables/index.ts"],
      "videojs-vue/audio/core": ["./src/audio/core.ts"],
      "videojs-vue/audio/composables": ["./src/audio/composables.ts"],
      "videojs-vue/skins/compat": ["./src/skins/compat.ts"],
      "videojs-vue/skins/default": ["./src/skins/default.ts"],
      "videojs-vue/skins/neutral": ["./src/skins/neutral.ts"],
      "videojs-vue/audio/skins/default": ["./src/audio/skins/default.ts"],
      "videojs-vue/audio/skins/neutral": ["./src/audio/skins/neutral.ts"],
      "videojs-vue/video/compat": ["./src/video/compat.ts"],
      "videojs-vue/video/default": ["./src/video/default.ts"],
      "videojs-vue/video/neutral": ["./src/video/neutral.ts"],
      "videojs-vue/audio/default": ["./src/audio/default.ts"],
      "videojs-vue/audio/neutral": ["./src/audio/neutral.ts"],
      "videojs-vue/ui/controls-group": ["./src/ui/MediaControlsGroup.ts"],
      "videojs-vue/ui/slider-fill": ["./src/ui/SliderFill.ts"],
      "videojs-vue/ui/controls": ["./src/ui/MediaControls.ts"],
      "videojs-vue/ui/controls-content": ["./src/ui/MediaControlsContent.ts"],
      "videojs-vue/ui/pip-button": ["./src/ui/PiPButton.ts"],
      "videojs-vue/ui/container": ["./src/ui/MediaContainer.ts"],
      "videojs-vue/ui/fullscreen-button": ["./src/ui/FullscreenButton.ts"],
      "videojs-vue/ui/poster": ["./src/ui/Poster.ts"],
      "videojs-vue/ui/seek-button": ["./src/ui/SeekButton.ts"],
      "videojs-vue/ui/play-button": ["./src/ui/PlayButton.ts"],
      "videojs-vue/ui/slider-thumb": ["./src/ui/SliderThumb.ts"],
      "videojs-vue/ui/mute-button": ["./src/ui/MuteButton.ts"],
      "videojs-vue/ui/slider-track": ["./src/ui/SliderTrack.ts"],
      "videojs-vue/ui/slider-buffer": ["./src/ui/SliderBuffer.ts"],
      "videojs-vue/ui/volume-slider": ["./src/ui/VolumeSlider.ts"],
      "videojs-vue/ui/status-announcer": ["./src/ui/StatusAnnouncer.ts"],
      "videojs-vue/ui/hotkey": ["./src/ui/Hotkey.ts"],
      "videojs-vue/ui/time-slider": ["./src/ui/TimeSlider.ts"],
      "videojs-vue/ui/time": ["./src/ui/Time.ts"],
      "videojs-vue/ui/captions-button": ["./src/ui/CaptionsButton.ts"]
    }
  },
  "exclude": ["playground", "**/dist", "**/node_modules"]
}
