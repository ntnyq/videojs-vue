{
  "extends": "@ntnyq/tsconfig/strict.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "target": "ESNext",
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["playground", "**/dist", "**/node_modules"]
}
