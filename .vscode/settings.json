{
  "oxc.enable": true,
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "js/ts.experimental.useTsgo": false,
  "cSpell.words": [
    "bumpp",
    "changelogithub",
    "codecov",
    "deindent",
    "effectful",
    "enterpictureinpicture",
    "esbuild",
    "hlsjs",
    "lcov",
    "leavepictureinpicture",
    "lucide",
    "modefy",
    "oklch",
    "onwarn",
    "oxfmt",
    "oxlint",
    "oxlintrc",
    "pnpm",
    "reka",
    "rgba",
    "RTMP",
    "RTSP",
    "shikijs",
    "tsdown",
    "tsgo",
    "unmute",
    "unrs",
    "unstub",
    "videojs",
    "vite",
    "vitepress",
    "vitest",
    "vueuse",
    "whib"
  ],
  "cSpell.allowCompoundWords": true
}
