{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "videojs-vue": ["../src/index.ts"],
      "videojs-vue/media/hls": ["../src/media/hls.ts"],
      "videojs-vue/ui": ["../src/ui/index.ts"],
      "videojs-vue/i18n": ["../src/i18n/index.ts"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "env.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
