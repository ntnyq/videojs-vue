{
  "name": "videojs-vue",
  "version": "0.4.0",
  "description": "Vue components and composables for Video.js v10 players.",
  "keywords": [
    "video-player",
    "videojs",
    "vue",
    "vue-plugin"
  ],
  "homepage": "https://github.com/ntnyq/videojs-vue#readme",
  "bugs": {
