    "play:legacy:build": "pnpm -C playground run legacy:build",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint build typecheck test test:package size:check play:build play:legacy:build size:play docs:build",
    "release:version": "bumpp",
    "size": "tsx scripts/bundle-size.ts",
    "size:check": "tsx scripts/bundle-size.ts --check",
    "size:play": "tsx scripts/playground-size.ts",
    "test": "vitest",
    "test:package": "vitest --config vitest.package.config.ts",
    "typecheck": "tsc --noEmit && pnpm -C playground typecheck"
