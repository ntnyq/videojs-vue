{
  "name": "videojs-vue",
  "version": "0.0.1",
  "description": "Vue components and composables for Video.js v10 players.",
  "keywords": [
    "video-player",
    "videojs",
    "vue",
    "vue-plugin"
  ],
  "homepage": "https://github.com/ntnyq/videojs-vue#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/videojs-vue/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": "ntnyq/videojs-vue",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/**/*.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./media/hls": {
      "types": "./dist/media/hls.d.ts",
      "default": "./dist/media/hls.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "play:build": "pnpm -C playground run build",
    "play:dev": "pnpm -C playground run dev",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test build play:build docs:build",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@videojs/html": "10.0.1"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.6.5",
    "@videojs/hlsjs-video": "10.0.1",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@videojs/hlsjs-video": "10.0.1",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@videojs/hlsjs-video": {
      "optional": true
    }
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.10.1"
}
