  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "play:build": "pnpm -C playground run build",
    "play:dev": "pnpm -C playground run dev",
    "play:legacy:build": "pnpm -C playground run legacy:build",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint build typecheck test test:package size:check play:build play:legacy:build size:play docs:build",
    "release:version": "bumpp",
    "size": "tsx scripts/bundle-size.ts",
    "size:check": "tsx scripts/bundle-size.ts --check",
    "size:play": "tsx scripts/playground-size.ts",
    "test": "vitest",
    "test:package": "vitest --config vitest.package.config.ts",
    "typecheck": "tsc --noEmit && pnpm -C playground typecheck"
  },
  "dependencies": {
    "@videojs/html": "10.0.1"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.6.5",
    "@videojs/hlsjs-video": "10.0.1",
    "bumpp": "^12.3.0",
    "core-js": "^3.51.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rolldown": "1.2.13",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@videojs/hlsjs-video": "10.0.1",
    "core-js": "^3.50.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@videojs/hlsjs-video": {
      "optional": true
    },
    "core-js": {
      "optional": true
    }
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.14.0"
}
